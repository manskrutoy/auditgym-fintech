{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditgym/invoice.schema.json",
  "title": "invoice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_id",
    "invoice_id",
    "entity_id",
    "issued_at",
    "due_at",
    "currency",
    "total_minor",
    "line_items"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "invoice_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "issued_at": {
      "type": "string",
      "description": "ISO-8601 with UTC offset"
    },
    "due_at": {
      "type": "string",
      "description": "ISO-8601 with UTC offset"
    },
    "currency": {
      "type": "string"
    },
    "total_minor": {
      "type": "integer"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_no",
          "description",
          "quantity",
          "unit_price_minor",
          "amount_minor"
        ]
      }
    }
  }
}