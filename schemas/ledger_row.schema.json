{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditgym/ledger_row.schema.json",
  "title": "ledger_row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "row_id",
    "timestamp",
    "account",
    "debit_minor",
    "credit_minor",
    "currency",
    "entity_id",
    "invoice_id",
    "payment_id"
  ],
  "properties": {
    "row_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 with UTC offset"
    },
    "account": {
      "type": "string"
    },
    "debit_minor": {
      "type": "integer",
      "minimum": 0
    },
    "credit_minor": {
      "type": "integer",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "entity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "invoice_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payment_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}